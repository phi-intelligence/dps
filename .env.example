# Copy to `.env.local` for local development:
#   cp .env.example .env.local
#
# Never commit `.env.local` — it is gitignored.

# ── Database (Prisma / SQLite) ─────────────────────────────
# Local dev default; Docker uses file:/data/dev.db
DATABASE_URL=file:./prisma/dev.db

# ── AI chat (/api/chat) ────────────────────────────────────
# Primary: Google Gemini. Read from .env.local on disk at runtime (hot-reload friendly).
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Fallback when Gemini fails or is unavailable
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Admin ──────────────────────────────────────────────────
# Optional. If set, POST /api/admin/register requires matching header:
#   x-admin-register-secret: <value>
# or Authorization: Bearer <value>
ADMIN_REGISTER_SECRET=

# Signs admin session cookies. Falls back to ADMIN_REGISTER_SECRET, then JWT_SECRET.
# Set a strong random value in production.
ADMIN_SESSION_SECRET=

# Legacy fallback for session signing if ADMIN_SESSION_SECRET is unset
JWT_SECRET=

# ── Public site URL (sitemap, robots, metadata) ────────────
NEXT_PUBLIC_SITE_URL=https://dps-heating.co.uk

# ── Service areas map (CARTO basemaps) ─────────────────────
# Required to remove "API KEY REQUIRED" watermark on Leaflet tiles.
# Free tier: https://carto.com/basemaps/apikey
NEXT_PUBLIC_CARTO_API_KEY=
