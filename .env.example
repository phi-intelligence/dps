PHI_DPS_SECRET_KEY=change-me
PHI_DPS_ACCESS_TOKEN_EXPIRE_MINUTES=60
PHI_DPS_ALGORITHM=HS256
PHI_DPS_DATABASE_URL=sqlite:///./dev.db
PHI_DPS_CORS_ORIGINS=http://localhost:3000
# Customer portal base URL for links in contract customer communications (templates)
# PHI_DPS_PORTAL_WEB_BASE=http://127.0.0.1:3000
# Support contact strings embedded in portal / comms copy (defaults exist if unset)
# PHI_DPS_PORTAL_SUPPORT_EMAIL=support@example.com
# PHI_DPS_PORTAL_SUPPORT_PHONE=+44 20 0000 0000

# Optional operator tag (documentation / runbooks only; app does not branch on this today)
# PHI_DPS_ENV=development

PHI_DPS_DEV_BOOTSTRAP=1
# In-process rollout automation loop — prefer 0 for production API replicas (use explicit cron/API instead)
PHI_DPS_ROLLOUT_RUNNER_ENABLED=1
PHI_DPS_ROLLOUT_RUNNER_SLEEP_SECONDS=30

PHI_DPS_NOTIFICATION_WEBHOOK_SECRET=change-me-webhook-secret
# HMAC secret for POST /webhooks/communications/provider (phi_generic_v1 JSON)
# PHI_DPS_COMMUNICATION_WEBHOOK_SECRET=change-me-comm-webhook-secret

# Outbound customer email / SMS (PHI_DPS_COMMUNICATION_ENABLED=0 keeps simulated in-process delivery for dev/tests)
# PHI_DPS_COMMUNICATION_ENABLED=0
# PHI_DPS_COMMUNICATION_EMAIL_PROVIDER=none
#   | smtp | sendgrid
# PHI_DPS_SENDGRID_API_KEY=
# PHI_DPS_COMMUNICATION_SMS_PROVIDER=none
#   | twilio — requires account SID, auth token, From number (E.164)
# PHI_DPS_TWILIO_ACCOUNT_SID=
# PHI_DPS_TWILIO_AUTH_TOKEN=
# PHI_DPS_TWILIO_FROM_NUMBER=
# Optional JSON map: {"repricing_proposal_released":"sms"} overrides default channel per communication_type
# PHI_DPS_COMMUNICATION_TYPE_CHANNEL_MAP_JSON=
# SendGrid Event Webhook → POST /webhooks/communications/sendgrid-events (JSON array); protect with header:
#   X-Phi-Dps-Sendgrid-Ingest-Secret: <same value as below>
# PHI_DPS_SENDGRID_WEBHOOK_INGEST_SECRET=
# §5.17 — customer communication templates (versioned keys phi_dps/cv{n}/{locale}/…; en + fr copy in code)
# PHI_DPS_COMMUNICATION_TEMPLATE_LOCALE=en
# PHI_DPS_COMMUNICATION_TEMPLATE_CATALOG_VERSION=1
# Per-contract override: PATCH /contracts/{id} with communication_locale (e.g. fr)
# Registry: GET /system/communication-template-registry
# PHI_DPS_SMTP_HOST=
# PHI_DPS_SMTP_PORT=587
# PHI_DPS_SMTP_USERNAME=
# PHI_DPS_SMTP_PASSWORD=
# PHI_DPS_SMTP_USE_TLS=1
# PHI_DPS_COMMUNICATION_FROM_EMAIL=
# PHI_DPS_COMMUNICATION_FROM_NAME=PHI-DPS
# PHI_DPS_COMMUNICATION_REPLY_TO=

# Optional: Google Gemini (secrets from env only — never commit real keys)
# GEMINI_ENABLED=0
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash
# GEMINI_BASE_URL=
# §5.19 — second switch for POST /ai/drafting/assist (also requires GEMINI_ENABLED=1 + GEMINI_API_KEY + RBAC permission can_ai_assisted_drafting)
# PHI_DPS_AI_ASSISTED_DRAFTING_ENABLED=0

# §5.18 — Holiday calendars: set external_feed_url + external_feed_format (ics|json) on a calendar, then POST /labour/calendars/{id}/import-feed
# (or pass feed_url in the request body). Admin permission can_manage_labour_rules.

# Legal e-sign provider (abstraction; stub is default for dev/tests)
# PHI_DPS_ESIGN_ENABLED=0
# PHI_DPS_ESIGN_PROVIDER=stub
#   | echo — second in-tree deterministic provider (phi_echo_esign_v1 webhooks; §5.16)
#   | docusign — DocuSign eSignature REST v2.1 (JWT grant + Connect JSON webhooks)
# When primary is not configured, optional fallback (e.g. echo or stub in dev):
# PHI_DPS_ESIGN_FALLBACK_PROVIDER=
# PHI_DPS_ESIGN_API_KEY=          # optional fallback if ESIGN_CLIENT_ID unset (Integration Key)
# PHI_DPS_ESIGN_CLIENT_ID=        # DocuSign Integration Key (preferred)
# PHI_DPS_ESIGN_USER_ID=          # DocuSign user GUID (impersonated subject for JWT)
# PHI_DPS_ESIGN_ACCOUNT_ID=       # DocuSign API Account ID (GUID)
# PHI_DPS_ESIGN_RSA_PRIVATE_KEY_PATH=  # PEM file path for JWT (never commit real keys)
# PHI_DPS_ESIGN_AUTH_SERVER=account-d.docusign.com   # demo OAuth host; production: account.docusign.com
# PHI_DPS_ESIGN_BASE_URL=https://demo.docusign.net/restapi
# PHI_DPS_ESIGN_RETURN_URL=https://your-portal.example/esign/return   # embedded signing returnUrl
# PHI_DPS_ESIGN_WEBHOOK_SECRET=   # DocuSign Connect HMAC secret; stub uses hex HMAC header below instead
# PHI_DPS_ESIGN_TEMPLATE_ID=      # reserved for future template-only flows (inline PDF used today)
# Webhook POST /webhooks/esign/provider:
#   stub: header X-Phi-Dps-Esign-Signature = HMAC-SHA256(body, secret) as lowercase hex
#   docusign: header X-DocuSign-Signature-1 = base64(HMAC-SHA256(body, Connect secret))

# Acceptance vs amendment/activation: warn_only | require_formal_acceptance_for_amendment |
# require_formal_acceptance_for_activation | require_provider_esign_for_activation |
# require_provider_esign_for_amendment_and_activation
# PHI_DPS_ACCEPTANCE_POLICY_MODE=warn_only
# When 1, successful amendment activation auto-creates an activation confirmation in pending_generation (§5.3).
# PHI_DPS_AUTO_CREATE_ACTIVATION_CONFIRMATION_ON_ACTIVATE=0

# Recurring job payloads (patch via PUT/PATCH on /system/jobs/{id} payload_json), not separate env vars:
# proposal_follow_up_scan JSON keys: released_no_view_days, viewed_no_response_days, esign_incomplete_days
# activation_confirmation_follow_up_scan: released_not_viewed_days, viewed_not_acknowledged_days

# --- Operations / deployment (see DEPLOYMENT.md) ---
# Health: GET /health (liveness), GET /health/ready (DB readiness)
# Diagnostics: GET /system/dashboard/operations-diagnostics (auth: system read roles)
# GET /system/integration-status — DB + comms + esign + storage flags (no secrets)
# GET /system/dashboard/operations-blockers-overview — cross-domain “needs attention” counts
# Document storage: PHI_DPS_DOCUMENT_STORAGE_PROVIDER=local|s3 (+ S3_* when s3)
# Recurring jobs CLI: PYTHONPATH=. python backend/scripts/run_due_recurring_jobs.py --limit 20
# Structured HTTP access logs (logger phi_dps.access): PHI_DPS_LOG_JSON_ACCESS=0

# --- Telemetry / dispatch (optional) ---
# PHI_DPS_TELEMETRY_FRESH_SECONDS=60
# PHI_DPS_TELEMETRY_AGING_SECONDS=300
# PHI_DPS_OPERATIONAL_POSITION_MODE=freshest
# PHI_DPS_DISPATCH_RECOMMEND_STALE=0
# PHI_DPS_AVG_VEHICLE_SPEED_MPS=13.89

# --- Ops recommendations engine ---
# PHI_DPS_OPS_RECOMMENDATION_RULE_VERSION=2025.03.v1
# PHI_DPS_OPS_REC_COOLDOWN_DISMISS_HOURS=24
# PHI_DPS_OPS_REC_COOLDOWN_RESOLVE_HOURS=6
# PHI_DPS_OPS_REC_ESCALATION_WINDOW_HOURS=168
# PHI_DPS_OPS_REC_ESCALATION_MIN_FIRES=5
# PHI_DPS_OPS_REC_ESCALATION_ENABLED=1

# --- Costing defaults ---
# PHI_DPS_LABOUR_HOURLY_RATE=60
# PHI_DPS_OVERTIME_MULTIPLIER=1.5
# PHI_DPS_STRICT_PARTS_RECONCILIATION=0

# --- Contracts / renewals ---
# PHI_DPS_CONTRACT_RENEWAL_SCAN_DAYS=90
# PHI_DPS_CONTRACT_OVERDUE_INVOICE_DAYS=30

# --- Equipment ---
# PHI_DPS_EQUIPMENT_CALIBRATION_DUE_SOON_DAYS=30

# --- Document storage (local default) ---
# PHI_DPS_DOCUMENT_STORAGE_ROOT=var/phi_dps_documents
# PHI_DPS_DOCUMENT_DOWNLOAD_TOKEN_TTL_SECONDS=300
# When PHI_DPS_DOCUMENT_STORAGE_PROVIDER=s3:
# PHI_DPS_S3_BUCKET=
# PHI_DPS_S3_REGION=us-east-1
# PHI_DPS_S3_ENDPOINT_URL=
# PHI_DPS_S3_ACCESS_KEY_ID=
# PHI_DPS_S3_SECRET_ACCESS_KEY=
# PHI_DPS_S3_PREFIX=phi-dps-documents
# PHI_DPS_S3_ADDRESSING_STYLE=path
# PHI_DPS_S3_PRESIGNED_TTL_SECONDS=300
# (Fallback: AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY if S3 keys unset)

# --- Branding (PDFs / templates) ---
# PHI_DPS_COMPANY_NAME=PHI-DPS Service Ltd
# PHI_DPS_COMPANY_TAGLINE=Field service & compliance
# PHI_DPS_COMPANY_ADDRESS=United Kingdom

# --- Dev bootstrap users (disable in production: PHI_DPS_DEV_BOOTSTRAP=0) ---
# PHI_DPS_ADMIN_EMAIL=admin@example.com
# PHI_DPS_ADMIN_PASSWORD=admin
# PHI_DPS_DISPATCHER_EMAIL=dispatcher@example.com
# PHI_DPS_DISPATCHER_PASSWORD=dispatcher
# PHI_DPS_ENGINEER_EMAIL=engineer@example.com
# PHI_DPS_ENGINEER_PASSWORD=engineer
# PHI_DPS_CLIENT_EMAIL=client@example.com
# PHI_DPS_CLIENT_PASSWORD=client
# PHI_DPS_FINANCE_EMAIL=finance@example.com
# PHI_DPS_FINANCE_PASSWORD=finance
# PHI_DPS_COMMERCIAL_EMAIL=commercial@example.com
# PHI_DPS_COMMERCIAL_PASSWORD=commercial
# PHI_DPS_OPS_MANAGER_EMAIL=ops.manager@example.com
# PHI_DPS_OPS_MANAGER_PASSWORD=opsmanager

# Default seeded recurring job intervals (new DBs only): proposal + activation follow-up scans use 180 minutes.

# --- §5.6 deploy audit (after exporting env in your shell or container entrypoint) ---
# PYTHONPATH=. python backend/scripts/check_deploy_env.py
# PYTHONPATH=. python backend/scripts/check_deploy_env.py --strict   # CI / pre-go-live (fails on dev-default secrets)

# PostgreSQL: if not using SQLite auto-migrations, apply DDL under backend/db/postgres/ when models gain columns.

# --- §5.8 recurring jobs CLI actor (optional; default admin@example.com in script) ---
# PHI_DPS_RECURRING_JOBS_ACTOR_EMAIL=admin@example.com

# --- Admin web (Create React App) — build-time; see web/.env.example ---
# Browser must reach this URL. Docker: pass build-arg REACT_APP_PHI_DPS_API_BASE or patch /config.js in the image.
# REACT_APP_PHI_DPS_API_BASE=https://api.yourcompany.com
