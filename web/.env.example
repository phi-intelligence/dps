# Create React App: only variables prefixed REACT_APP_ are exposed to the bundle.
# Copy to web/.env.local for local overrides (do not commit).

# Public API origin as seen by the **browser** (no trailing slash).
# REACT_APP_PHI_DPS_API_BASE=http://127.0.0.1:8000

# Production: use your HTTPS API host, or leave unset and override /config.js after deploy.
